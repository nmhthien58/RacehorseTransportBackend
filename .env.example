# Biến môi trường cho bản deploy (Railway: tab Variables -> Raw Editor -> dán toàn bộ file này).
# Đây là file MẪU. Copy thành .env rồi điền giá trị thật; .env không được commit.
# chạy ở máy thì dùng RacehorseTransport.API/appsettings.Local.json.

# --- Database: lấy ở Supabase -> Connect -> Session pooler. Điền 2 chỗ <...>
ConnectionStrings__DefaultConnection="Host=<HOST_SESSION_POOLER>;Port=5432;Database=postgres;Username=postgres.<mã project>;Password=<MAT_KHAU_DATABASE>;SSL Mode=Require;Trust Server Certificate=true"

# --- Khóa ký JWT: tạo bằng lệnh trong docs/DEPLOY.md. Mỗi môi trường một khóa riêng.
Jwt__Key=<chuỗi ngẫu nhiên từ 32 ký tự>

# --- Supabase Storage
Supabase__Url=https://<mã project>.supabase.co
Supabase__ServiceKey=<khóa service_role hoặc secret key>
Supabase__Bucket=<tên bucket>

# --- Địa chỉ frontend được phép gọi API (thêm __1, __2 nếu có nhiều). Sửa lại khi có domain thật.
Cors__AllowedOrigins__0=http://localhost:5173

# --- Email (xem docs/DEPLOY.md, mục Email). Railway chặn cổng SMTP nên bản deploy dùng Brevo (API qua HTTPS).
Email__Provider=Brevo
Email__FromAddress=<địa chỉ người gửi đã xác nhận trong Brevo>
Email__Brevo__ApiKey=<khóa API của Brevo>
Email__FrontendBaseUrl=http://localhost:5173

# --- Môi trường chạy
ASPNETCORE_ENVIRONMENT=Production
