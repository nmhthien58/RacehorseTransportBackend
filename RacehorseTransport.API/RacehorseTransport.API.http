  "countryCode": "VN",
  "direction": "Import",
  "docTypeId": 1,
  "validityDays": 365,
  "isMandatory": true,
  "regulationNote": "Dữ liệu thử B-02"
}

###
@createdRequirementId = {{createCountryRequirement.response.body.$.data.requirementId}}

